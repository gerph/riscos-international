/*******************************************************************
 Function:      international_country_alphabet
 Description:   Returns the alphabet associated with a country.
 Parameters:    country = country number
                alphabet = returned alphabet number
 Returns:       non-zero if the country was recognised
 ******************************************************************/
int international_country_alphabet(uint32_t country, uint32_t *alphabet)
{
    uint32_t index;

    for (index = 0; index < sizeof(country_alphabets) / sizeof(country_alphabets[0]); index++)
    {
        if (country_alphabets[index].country == country)
        {
            *alphabet = country_alphabets[index].alphabet;
            return 1;
        }
    }

    return 0;
}
