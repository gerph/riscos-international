static int fold_character(int character)
{
    if (character >= 'a' && character <= 'z')
    {
        return character - ('a' - 'A');
    }

    return character;
}

/*******************************************************************
 Function:      international_lookup_name
 Description:   Looks up an International name, accepting an abbreviated name.
 Parameters:    names = table to search
                count = number of entries
                name = supplied name
                number = returned number
 Returns:       non-zero if recognised
 ******************************************************************/
int international_lookup_name(const InternationalName *names,
                              uint32_t count,
                              const char *name,
                              uint32_t *number)
{
    uint32_t index;
    const char *candidate;
    const char *input;
    int abbreviated;

    for (index = 0; index < count; index++)
    {
        candidate = names[index].name;
        input = name;
        abbreviated = 0;
        while (*input != '\0' && *input > ' ')
        {
            if (*input == '.')
            {
                abbreviated = 1;
                input++;
                break;
            }
            if (fold_character((unsigned char)*input) !=
                fold_character((unsigned char)*candidate))
            {
                break;
            }
            input++;
            candidate++;
        }
        if ((*input == '\0' || *input <= ' ') && *candidate == '\0')
        {
            *number = names[index].number;
            return 1;
        }
        if (abbreviated && (*input == '\0' || *input <= ' '))
        {
            *number = names[index].number;
            return 1;
        }
    }

    return 0;
}

/*******************************************************************
 Function:      international_lookup_number
 Description:   Looks up an International numeric identifier.
 Parameters:    names = table to search
                count = number of entries
                number = identifier to find
 Returns:       matching name, or NULL
 ******************************************************************/
const char *international_lookup_number(const InternationalName *names,
                                        uint32_t count,
                                        uint32_t number)
{
    uint32_t index;

    for (index = 0; index < count; index++)
    {
        if (names[index].number == number)
        {
            return names[index].name;
        }
    }

    return 0;
}

/*******************************************************************
 Function:      international_ucs_glyph
 Description:   Finds a glyph by UCS codepoint.
 Parameters:    codepoint = UCS codepoint
 Returns:       glyph, or NULL
 ******************************************************************/
const InternationalGlyph *international_ucs_glyph(uint32_t codepoint)
{
    uint32_t index;

    for (index = 0; index < sizeof(glyph_aliases) / sizeof(glyph_aliases[0]); index++)
    {
        if (glyph_aliases[index].alias == codepoint)
        {
            codepoint = glyph_aliases[index].glyph;
            break;
        }
    }

    for (index = 0; index < international_glyph_count; index++)
    {
        if (international_glyphs[index].codepoint == codepoint)
        {
            return &international_glyphs[index];
        }
    }

    return 0;
}

/*******************************************************************
 Function:      international_font_glyph
 Description:   Finds a glyph for an alphabet and system-font character.
 Parameters:    alphabet = alphabet number
                character = system font character
 Returns:       glyph, or NULL
 ******************************************************************/
const InternationalGlyph *international_font_glyph(uint32_t alphabet,
                                                    uint32_t character)
{
    uint32_t font_index;
    uint32_t entry_index;
    const InternationalFont *font;

    for (font_index = 0; font_index < international_font_count; font_index++)
    {
        font = &international_fonts[font_index];
        if (font->alphabet == alphabet)
        {
            for (entry_index = 0; entry_index < font->entry_count; entry_index++)
            {
                if (font->entries[entry_index].character == character)
                {
                    return international_ucs_glyph(font->entries[entry_index].codepoint);
                }
            }
            return 0;
        }
    }

    return 0;
}
